{
  "name": "battle-forge",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href \"/battle-forge/\"",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:firebase": "firebase emulators:exec --config firebase.test.json --project demo-battle-forge --only database \"vitest run --config vitest.firebase.config.ts\"",
    "test:all": "npm run test:ci && npm run test:firebase",
    "emulator:firebase": "firebase emulators:start --config firebase.test.json --project demo-battle-forge --only database"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "firebase": "^12.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20",
    "@angular/compiler-cli": "^20.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "firebase-tools": "15.24.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "vitest": "3.2.7"
  }
}
