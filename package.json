{
  "name": "battle-forge",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:dev": "npm --prefix server run start:dev",
    "server:test": "npm --prefix server run test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:all": "npm run test:ci && npm run server:test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20",
    "@angular/compiler-cli": "^20.3.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "vitest": "3.2.7"
  }
}
